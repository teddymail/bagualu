config bagualu 'main'
	option enabled '1'
	option listen '127.0.0.1'
option port '18787'
	option data_dir '/var/lib/bagualu'
	option status_file '/var/run/bagualu/status.json'
option mihomo_control_port '19090'
option mihomo_proxy_port '17890'
	option mihomo_binary '/usr/bin/mihomo'
	option mihomo_repository 'MetaCubeX/mihomo'
	option mihomo_version 'latest'
	option mihomo_token 'change-this-token'
	option mihomo_selector '八卦炉-Test'
	option test_queue_limit '32'
	option interval_seconds '60'
	option throughput_enabled '1'
	option throughput_url 'https://speed.cloudflare.com/__down?bytes=1048576'
	option throughput_bytes '1048576'
	option throughput_windows '02:00-06:00'
	option wan_download_bps '0'
	option wan_upload_bps '0'
	option load_threshold '0.1'
