#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

start_service() {
	config_load bagualu
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0
	procd_open_instance
	procd_set_param command /usr/bin/bagualu -config /etc/config/bagualu
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 30
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	config_load bagualu
	config_get data_dir main data_dir /var/lib/bagualu
	for pid in $(pidof mihomo 2>/dev/null); do
		cmdline=$(tr '\0' ' ' </proc/$pid/cmdline 2>/dev/null || true)
		case "$cmdline" in
			*"-f $data_dir/bagualu.yaml"*) kill -9 "$pid" 2>/dev/null || true ;;
		esac
	done
}

service_triggers() {
	procd_add_reload_trigger bagualu
}
